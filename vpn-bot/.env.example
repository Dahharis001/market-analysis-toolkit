# Telegram
TELEGRAM_BOT_TOKEN=
ADMIN_CHAT_IDS=123456789

# Локальный прокси для обращений к внешним сервисам (Telegram, OpenRouter, CryptoBot).
# Нужен, если сервер стоит в РФ — оттуда эти API отвечают через раз.
# Оставьте пустым, чтобы обращаться напрямую.
OUTBOUND_PROXY=http://127.0.0.1:10809

# Platega.io (docs.platega.io) - выдаются в личном кабинете после подключения
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=

# CryptoBot (https://pay.crypt.bot/api) - токен из @CryptoBot
CRYPTOBOT_TOKEN=

# OpenRouter (https://openrouter.ai) - ИИ-ассистент поддержки внутри бота
OPENROUTER_API_KEY=
SUPPORT_MODEL=deepseek/deepseek-chat

# 3x-ui панель на VPN-сервере
XUI_PANEL_URL=http://127.0.0.1:2053
XUI_USERNAME=
XUI_PASSWORD=
XUI_INBOUND_ID=1
XUI_SERVER_HOST=1.2.3.4
XUI_VERIFY_SSL=true

# Реферальная программа — награда днями, обеим сторонам, при первой оплате приглашённого
REFERRAL_DAYS_INVITER=14
REFERRAL_DAYS_INVITEE=7

# Старая схема с процентами: новые начисления не идут, но остатки на балансах выводятся
REFERRAL_PERCENT=20
MIN_WITHDRAWAL_RUB=300

# Порт для /sub/<token> (сервис подписки, сейчас не используется в основном сценарии) — проверьте, что порт свободен на сервере
SUB_SERVER_PORT=8181
SUB_BASE_URL=http://1.2.3.4:8181

STATE_PATH=state.json
