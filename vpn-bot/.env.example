# Telegram
TELEGRAM_BOT_TOKEN=
ADMIN_CHAT_IDS=123456789

# Platega.io (docs.platega.io) - выдаются в личном кабинете после подключения
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=

# CryptoBot (https://pay.crypt.bot/api) - токен из @CryptoBot
CRYPTOBOT_TOKEN=

# 3x-ui панель на VPN-сервере
XUI_PANEL_URL=http://127.0.0.1:2053
XUI_USERNAME=
XUI_PASSWORD=
XUI_INBOUND_ID=1
XUI_SERVER_HOST=1.2.3.4
XUI_VERIFY_SSL=true

# Реферальная программа
REFERRAL_PERCENT=20
MIN_WITHDRAWAL_RUB=300

# Порт для /sub/<token> (sing-box подписка с обходом RU) — проверьте, что порт свободен на сервере
SUB_SERVER_PORT=8181
SUB_BASE_URL=http://1.2.3.4:8181

STATE_PATH=state.json
