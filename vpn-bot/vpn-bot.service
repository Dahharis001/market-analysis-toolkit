[Unit]
Description=Telegram VPN subscription bot (Platega + 3x-ui)
# The bot talks to the 3x-ui panel on localhost and reaches Telegram through a local
# proxy, so on boot it must come up after both. Ordering only — if a unit is absent
# or named differently on this host, systemd ignores the entry instead of failing.
After=network-online.target x-ui.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/vpn-bot
ExecStart=/opt/vpn-bot/venv/bin/python /opt/vpn-bot/main.py
Restart=always
RestartSec=5
StandardOutput=append:/opt/vpn-bot/bot.log
StandardError=append:/opt/vpn-bot/bot.err.log

[Install]
WantedBy=multi-user.target
