# Copy this file to .env and fill in real values. Never commit .env.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Video generation model (OpenRouter model slug). Kling v3.0 Standard (~$0.10/sec).
VIDEO_MODEL=kwaivgi/kling-v3.0-std

# Image generation/edit model (OpenRouter model slug, via chat completions with
# modalities=["image","text"]). Used to render one still photo per stage before
# any video is generated - these stills also become the first/last-frame anchors
# for each video clip.
IMAGE_MODEL=google/gemini-2.5-flash-image

# Vision-capable chat model used to look at the reference photo and write the
# per-stage prompts.
STAGE_PROMPT_MODEL=openai/gpt-5

# Seconds per generated clip (model-dependent max, usually up to 15).
CLIP_DURATION_SEC=8

# Whether to ask the video model to generate synchronized audio (costs more,
# and the bundled ffmpeg stitching step currently drops audio on crossfade).
GENERATE_AUDIO=false

# Reference photo in the example is portrait/vertical - keep 9:16 unless yours
# is landscape (then use 16:9).
ASPECT_RATIO=9:16
RESOLUTION=1080p
